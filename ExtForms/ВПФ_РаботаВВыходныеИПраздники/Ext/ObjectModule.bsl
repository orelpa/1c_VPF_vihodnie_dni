Функция ОпределитьРежимРаботыСотрудников(КолличествоЧасов)
	РежимРаботы = Новый Структура;
	РежимРаботы.Вставить("Перерыв", "12:00-12:45");
	Если КолличествоЧасов = 11 Тогда
		РежимРаботы.Вставить("Режим", "8:30 - 20:30");
		Строка = "12:00 - 12:30
		|16:00 - 16:30"; 
		РежимРаботы.Перерыв =  Строка;
	ИначеЕсли КолличествоЧасов = 8 ИЛИ КолличествоЧасов = 0 Тогда
		РежимРаботы.Вставить("Режим", "8:30 - 17:15");
	ИначеЕсли КолличествоЧасов = 7.2 Тогда
		РежимРаботы.Вставить("Режим", "8:30 - 16:27");
	ИначеЕсли КолличествоЧасов = 7 Тогда
		РежимРаботы.Вставить("Режим", "8:30 - 16:15");
	ИначеЕсли КолличествоЧасов = 6.2 Тогда
		РежимРаботы.Вставить("Режим", "8:30 - 15:27");
	Иначе
		РежимРаботы.Вставить("Режим", "-");
		РежимРаботы.Вставить("Перерыв", "-");
	КонецЕсли;
	Возврат РежимРаботы;
КонецФункции  	
