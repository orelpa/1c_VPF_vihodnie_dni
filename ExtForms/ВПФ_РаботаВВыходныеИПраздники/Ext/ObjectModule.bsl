    ОбластьТабСогл.Параметры.Заполнить(ПолучитьДанныеПоДолжности("Главный бухгалтер",ДанныеДляПечатиТаблиц[0][0].ПодразделениеСсылка.ГоловнаяОрганизация)); 
	ТабДокумент.Вывести(ОбластьТабСогл);  
	
	                                
	РукЮрОтдела = ПолучитьРукЮРОтдела(МассивОбъектов.Руководитель);	
	ДолжностьРукЮрОтдела = ПолучитьДолжностьОтветственного(РукЮрОтдела);
	ОбластьТабСогл.Параметры.Должность = ДолжностьРукЮрОтдела;
	ОбластьТабСогл.Параметры.Сотрудник = РукЮрОтдела.Инициалы + РукЮрОтдела.Фамилия;
	
	//ОбластьТабСогл.Параметры.Заполнить(ПолучитьДанныеПоДолжности("Начальник отдела по правовым вопросам",ДанныеДляПечатиТаблиц[0][0].ПодразделениеСсылка.ГоловнаяОрганизация)); 
	ТабДокумент.Вывести(ОбластьТабСогл);
	ОбластьТабСогл.Параметры.Заполнить(ПолучитьДанныеПоДолжности("Руководитель службы персонала",ДанныеДляПечатиТаблиц[0][0].ПодразделениеСсылка.ГоловнаяОрганизация)); 
	ТабДокумент.Вывести(ОбластьТабСогл);
	//ОбластьТабСогл.Параметры.Заполнить(ПолучитьДанныеПоДолжности("Начальник основного производства",ДанныеДляПечатиТаблиц[0][0].ПодразделениеСсылка.ГоловнаяОрганизация));
	////Тест = ПолучитьРук(ДанныеДляПечатиТаблиц[0][0].ПодразделениеСсылка);
	////ОбластьТабСогл.Параметры.Заполнить(ПолучитьРук(ДанныеДляПечатиТаблиц[0][0].ПодразделениеСсылка));
	////ТабДокумент.Вывести(ОбластьТабСогл);
	
