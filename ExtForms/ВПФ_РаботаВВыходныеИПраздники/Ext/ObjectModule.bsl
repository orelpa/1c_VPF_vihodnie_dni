	//Если ЗначениеЗаполнено(Руководитель.Рук) Тогда 
	//	ОбластьПункт2.Параметры.Рук = ПолучитьСклоненияСтроки(Руководитель.Рук, ,"ПД=Дательный")[0];
	//КонецЕсли;
	ОбластьПункт2.Параметры.НомерПункта = НомерПункта;	
	ТабДокумент.Вывести(ОбластьПункт2);
	
	ОбластьПункт3.Параметры.НомерПункта = НомерПункта;
	ОбластьПункт3.Параметры.МесяцПрописью = НРег(Формат(МассивОбъектов.ДатаНачалаСобытия, "ДФ=MMMM"));
	ОбластьПункт3.Параметры.Год = Формат(МассивОбъектов.ДатаНачалаСобытия, "ДФ=yyyy");
	Если ЕстьВидОплатыДвойной и не ЕстьВидОплатыОдинарный Тогда
		СтрокаКодОплаты = "«РВ» (оплата труда в двойном размере)"; 
	ИначеЕсли не ЕстьВидОплатыДвойной и ЕстьВидОплатыОдинарный Тогда
		СтрокаКодОплаты = "«ПН» (оплата труда в одинарном размере с предоставлением другого выходного дня)";
	ИначеЕсли ЕстьВидОплатыДвойной и ЕстьВидОплатыОдинарный Тогда
		СтрокаКодОплаты = "«РВ» (оплата труда в двойном размере) или «ПН» (оплата труда в одинарном размере с предоставлением другого выходного дня)";
	Иначе
		СтрокаКодОплаты = "";
	КонецЕсли;
	ОбластьПункт3.Параметры.Код = СтрокаКодОплаты;
	ТабДокумент.Вывести(ОбластьПункт3);
	
    Если ЕстьВидОплатыОдинарный Тогда 
		ОбластьПункт4.Параметры.НомерПункта = НомерПункта;  
		ТабДокумент.Вывести(ОбластьПункт4);
	КонецЕсли;
	
	ОбластьПункт5.Параметры.НомерПункта = НомерПункта;
	ДатаОзнакомления = МассивОбъектов.ДатаНачалаСобытия;
	ОбластьПункт5.Параметры.ДатаОзнакомления = Формат(ПолучитьДатуОзнакомления(ДатаОзнакомления), "ДФ=dd.MM.yyyy");
	Если ЕстьВидОплатыОдинарный Тогда
		ОбластьПункт5.Параметры.ПодПункт = 3;
	Иначе 
		ОбластьПункт5.Параметры.ПодПункт = 2;
	КонецЕсли;
	Если ЕстьВидОплатыДвойной и ЕстьВидОплатыОдинарный Тогда
		ОбластьПункт5.Параметры.ПунктКонтекст = "п.1, п.2";
