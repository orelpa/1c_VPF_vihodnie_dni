Функция ПолучитьСотрудниковИзДокумента(МассивОбъектов)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник КАК Сотрудник,
	|	РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник.Код КАК СотрудникКод,
	|	КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность,
	|	РаботаВВыходныеИПраздничныеДниСотрудники.ОтработаноЧасов КАК ОтработаноЧасов,
	|	РаботаВВыходныеИПраздничныеДниСотрудники.СпособКомпенсацииПереработки КАК СпособКомпенсацииПереработки,
	|	КадроваяИсторияСотрудниковСрезПоследних.Подразделение.Наименование КАК Подразделение,
	|	КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК ПодразделениеСсылка,
	|	РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник.Наименование КАК СотрудникНаименование
	|ИЗ
	|	Документ.РаботаВВыходныеИПраздничныеДни.Сотрудники КАК РаботаВВыходныеИПраздничныеДниСотрудники
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудниковСрезПоследних
	|		ПО РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник.Ссылка = КадроваяИсторияСотрудниковСрезПоследних.Сотрудник
	|ГДЕ
	|	РаботаВВыходныеИПраздничныеДниСотрудники.Ссылка = &Ссылка
	|	И РаботаВВыходныеИПраздничныеДниСотрудники.ОтработаноЧасов > &Часы
	|
	|УПОРЯДОЧИТЬ ПО
	|	СотрудникНаименование";
	
	Запрос.УстановитьПараметр("Ссылка", МассивОбъектов);
	Если МассивОбъектов.ВремяВЧасах Тогда
		Запрос.УстановитьПараметр("Часы", 0);
	Иначе
		Запрос.УстановитьПараметр("Часы", -1);
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(); 
	
	Возврат РезультатЗапроса;

КонецФункции
