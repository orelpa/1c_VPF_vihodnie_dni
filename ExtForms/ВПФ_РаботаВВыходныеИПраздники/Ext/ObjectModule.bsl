	ТабДокумент.Вывести(ОбластьУведомление);
	
	Для каждого Сотрудник из СотрудникиДляОзн Цикл	
		ОбластьСотрудникУв.Параметры.СотрУв = Сотрудник.Инициалы + " " + Сотрудник.Фамилия;
		ТабДокумент.Вывести(ОбластьСотрудникУв);	
	КонецЦикла;	
	
	ТабДокумент.АвтоМасштаб = Истина;
	Возврат ТабДокумент;
	
КонецФункции

Функция СформироватьПриказОбОплатеЗаРаботуВВыходнойИПраздничныйДень(МассивОбъектов, ОбъектыПечати, ПараметрыПечати) Экспорт
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_РаботаВВыходныеИПраздничныеДни";
	Макет = ПолучитьМакет("ВПФ_MXL_ПриказОбОплатеЗаРаботуВВыходнойИПраздничныйДень");
	
	ОбластьКартинки     = Макет.ПолучитьОбласть("ТКС");
	ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
	ОбластьПодвал       = Макет.ПолучитьОбласть("Подвал");
	ОбластьОзнакомление = Макет.ПолучитьОбласть("Ознакомление");
	ОбластьСотрудникОЗ  = Макет.ПолучитьОбласть("СотрудникОЗ");
	ТабДокумент.Вывести(ОбластьКартинки);
	
	ОбластьШапка.Параметры.ДатаДок  =  Формат(МассивОбъектов.Дата,"ДЛФ=DD");
	ОбластьШапка.Параметры.НомерДок =  МассивОбъектов.Номер;
	ОбластьШапка.Параметры.Причина  =  МассивОбъектов.Причина;
	ТабДокумент.Вывести(ОбластьШапка);
	
	МассивДР        = Новый Массив;
	МассивОРПДВ     = Новый Массив;
	МассивФактДР    = Новый Массив;
	МассивФактОРПДВ = Новый Массив;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеОперативногоУчетаРабочегоВремениСотрудников.Период КАК Дата,
	|	ДанныеОперативногоУчетаРабочегоВремениСотрудников.Сотрудник КАК Сотрудник,
	|	ДанныеОперативногоУчетаРабочегоВремениСотрудников.Часы КАК Часы,
	|	ДанныеОперативногоУчетаРабочегоВремениСотрудников.ВидУчетаВремени КАК СпособКомпенсации,
	|	КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность
	|ИЗ
	|	РегистрНакопления.ДанныеОперативногоУчетаРабочегоВремениСотрудников КАК ДанныеОперативногоУчетаРабочегоВремениСотрудников
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудниковСрезПоследних
	|		ПО ДанныеОперативногоУчетаРабочегоВремениСотрудников.Сотрудник = КадроваяИсторияСотрудниковСрезПоследних.Сотрудник
	|ГДЕ
	|	ДанныеОперативногоУчетаРабочегоВремениСотрудников.Регистратор = &Регистратор
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеОперативногоУчетаРабочегоВремениСотрудников.Сотрудник,
	|	ДанныеОперативногоУчетаРабочегоВремениСотрудников.Период,
	|	ДанныеОперативногоУчетаРабочегоВремениСотрудников.Часы,
	|	ДанныеОперативногоУчетаРабочегоВремениСотрудников.ВидУчетаВремени,
	|	КадроваяИсторияСотрудниковСрезПоследних.Должность";
	
	Запрос.УстановитьПараметр("Регистратор", МассивОбъектов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураИзменеия = Новый Структура("Дата,Сотрудник,ТабНомер,Часы,СпособКомпенсации,Должность");
		ЗаполнитьЗначенияСвойств(СтруктураИзменеия, ВыборкаДетальныеЗаписи);
		
		Если  ВыборкаДетальныеЗаписи.Должность = Справочники.Должности.НайтиПоНаименованию("Овощевод") И ВыборкаДетальныеЗаписи.СпособКомпенсации = Справочники.ВидыИспользованияРабочегоВремени.Праздники Тогда	
			МассивДР.Добавить(СтруктураИзменеия);
		ИначеЕсли ВыборкаДетальныеЗаписи.Должность = Справочники.Должности.НайтиПоНаименованию("Овощевод") И ВыборкаДетальныеЗаписи.СпособКомпенсации = Справочники.ВидыИспользованияРабочегоВремени.ПраздникиБезПовышеннойОплаты Тогда
			МассивОРПДВ.Добавить(СтруктураИзменеия);
		ИначеЕсли ВыборкаДетальныеЗаписи.Должность <> Справочники.Должности.НайтиПоНаименованию("Овощевод") И ВыборкаДетальныеЗаписи.СпособКомпенсации = Справочники.ВидыИспользованияРабочегоВремени.Праздники Тогда
			МассивФактДР.Добавить(СтруктураИзменеия);
		ИначеЕсли ВыборкаДетальныеЗаписи.Должность <> Справочники.Должности.НайтиПоНаименованию("Овощевод") И ВыборкаДетальныеЗаписи.СпособКомпенсации = Справочники.ВидыИспользованияРабочегоВремени.ПраздникиБезПовышеннойОплаты Тогда
			МассивФактОРПДВ.Добавить(СтруктураИзменеия);	
		КонецЕсли;
		
	КонецЦикла;
	
	
	//Двойной размер оплаты только (овощеводы)
	
	Если МассивДР.Количество() > 0 Тогда
		
		ТабЗначДРСотрудник = Новый ТаблицаЗначений;
		Для Каждого ЭлементМассива Из МассивДР Цикл
			Если ТабЗначДРСотрудник.Колонки.Количество() = 0 Тогда
				Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
					ТабЗначДРСотрудник.Колонки.Добавить(ЗначениеСтруктуры.Ключ);
				КонецЦикла;
			КонецЕсли;
			НоваяСтрока = ТабЗначДРСотрудник.Добавить();
			Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
				НоваяСтрока[ЗначениеСтруктуры.Ключ] = ЗначениеСтруктуры.Значение;
			КонецЦикла;
		КонецЦикла;
		МассивДРСотрудник = Новый Массив;
		МассивДРСотрудник.Добавить(ТабЗначДРСотрудник.ВыгрузитьКолонку("Сотрудник"));
		
		ОбластьДвойнойРазмер           = Макет.ПолучитьОбласть("ДвойнойРазмер");
		ТабДокумент.Вывести(ОбластьДвойнойРазмер);
		ОбластьСотрудникиДвойнойРазмер = Макет.ПолучитьОбласть("СотрудникиДвойнойРазмер");
		
		ЗапросСотрудников = Новый Запрос;
		ЗапросСотрудников.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник КАК Сотрудник,
		|	РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник.Код КАК СотрудникКод,
		|	КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность
		|ИЗ
		|	Документ.РаботаВВыходныеИПраздничныеДни.Сотрудники КАК РаботаВВыходныеИПраздничныеДниСотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудниковСрезПоследних
		|		ПО РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник.Ссылка = КадроваяИсторияСотрудниковСрезПоследних.Сотрудник
		|ГДЕ
		|	РаботаВВыходныеИПраздничныеДниСотрудники.Ссылка = &Ссылка
		|	И РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник В(&МассивДР)";
		ЗапросСотрудников.УстановитьПараметр("Ссылка",МассивОбъектов);
		ЗапросСотрудников.УстановитьПараметр("МассивДР",МассивДРСотрудник[0]);
		РезультатЗапросаСотрудники = ЗапросСотрудников.Выполнить();
		ВыборкаДетальныеЗаписиСотрудников = РезультатЗапросаСотрудники.Выбрать();
		
		СписокДат = Новый СписокЗначений;
		
		Пока ВыборкаДетальныеЗаписиСотрудников.Следующий() Цикл
			Для каждого Элемент Из МассивДР Цикл
				Если ВыборкаДетальныеЗаписиСотрудников.Сотрудник = Элемент.Сотрудник Тогда
					СписокДат.Добавить(Формат(Элемент.Дата,"ДФ=dd.MM.yyyy"));
				КонецЕсли;
			КонецЦикла;
			
			ОбластьСотрудникиДвойнойРазмер.Параметры.ДолжностьДР    = ВыборкаДетальныеЗаписиСотрудников.Должность;
			ОбластьСотрудникиДвойнойРазмер.Параметры.ФИОработникаДР = ВыборкаДетальныеЗаписиСотрудников.Сотрудник;
			ОбластьСотрудникиДвойнойРазмер.Параметры.КодДР          = ВыборкаДетальныеЗаписиСотрудников.СотрудникКод;
			ОбластьСотрудникиДвойнойРазмер.Параметры.ДатаДР         = СписокДат;
			ТабДокумент.Вывести(ОбластьСотрудникиДвойнойРазмер);
			СписокДат.Очистить();
			
		КонецЦикла;
	КонецЕсли;
	
	
	//одинарный размер оплаты + выходной в другой день только (овощеводы)
	
	Если МассивОРПДВ.Количество() > 0 Тогда
		
		ТабЗначОРПДВ = Новый ТаблицаЗначений;
		Для Каждого ЭлементМассива Из МассивОРПДВ Цикл
			Если ТабЗначОРПДВ.Колонки.Количество() = 0 Тогда
				Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
					ТабЗначОРПДВ.Колонки.Добавить(ЗначениеСтруктуры.Ключ);
				КонецЦикла;
			КонецЕсли;
			НоваяСтрока = ТабЗначОРПДВ.Добавить();
			Для Каждого ЗначениеСтруктуры Из ЭлементМассива Цикл
				НоваяСтрока[ЗначениеСтруктуры.Ключ] = ЗначениеСтруктуры.Значение;
			КонецЦикла;
		КонецЦикла;
		МассивОРПДВСотрудник = Новый Массив;
		МассивОРПДВСотрудник.Добавить(ТабЗначОРПДВ.ВыгрузитьКолонку("Сотрудник"));
		
		ОбластьОдинРазПредДрВых        = Макет.ПолучитьОбласть("ОдинРазПредДрВых");
		ТабДокумент.Вывести(ОбластьОдинРазПредДрВых);
		ОбластьСотрудникиОРПДВ         = Макет.ПолучитьОбласть("СотрудникиОРПДВ");
		
		ЗапросОРПДВ = Новый Запрос;
		ЗапросОРПДВ.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник КАК Сотрудник
		|ИЗ
		|	Документ.РаботаВВыходныеИПраздничныеДни.Сотрудники КАК РаботаВВыходныеИПраздничныеДниСотрудники
		|ГДЕ
		|	РаботаВВыходныеИПраздничныеДниСотрудники.Ссылка = &Ссылка
		|	И РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник В(&МассивОРПДВСотрудник)";
		ЗапросОРПДВ.УстановитьПараметр("Ссылка",МассивОбъектов);
		ЗапросОРПДВ.УстановитьПараметр("МассивОРПДВСотрудник",МассивОРПДВСотрудник[0]);
		РезультатЗапросаОРПДВ = ЗапросОРПДВ.Выполнить();
		ВыборкаДетальныеЗаписиОРПДВ = РезультатЗапросаОРПДВ.Выбрать();
		
		СписокДатОРПДВ = Новый СписокЗначений;
		
		Пока ВыборкаДетальныеЗаписиОРПДВ.Следующий() Цикл
			Для каждого Элемент Из МассивОРПДВ Цикл
				Если ВыборкаДетальныеЗаписиОРПДВ.Сотрудник = Элемент.Сотрудник Тогда
					СписокДатОРПДВ.Добавить(Формат(Элемент.Дата,"ДФ=dd.MM.yyyy"));
				КонецЕсли;
			КонецЦикла;
			
			ОбластьСотрудникиОРПДВ.Параметры.ФИОработникаОРПДВ = ВыборкаДетальныеЗаписиОРПДВ.Сотрудник;	
			ОбластьСотрудникиОРПДВ.Параметры.ДатаОРПДВ         = СписокДатОРПДВ;
			ТабДокумент.Вывести(ОбластьСотрудникиОРПДВ);
			СписокДатОРПДВ.Очистить();	
		КонецЦикла;	
	КонецЕсли;
	
	
	//одинарный размер оплаты + выходной в другой день (все кроме овощеводов)
	
	
	Если МассивФактОРПДВ.Количество() > 0 Тогда
		
		ОбластьФктВремяОРПДВ           = Макет.ПолучитьОбласть("ФктВремяОРПДВ");
		ТабДокумент.Вывести(ОбластьФктВремяОРПДВ);
		ОбластьСотрудникиФктВремяОРПДВ = Макет.ПолучитьОбласть("СотрудникиФктВремяОРПДВ");
		
		Для Каждого Элемент Из МассивФактОРПДВ Цикл
			 ОбластьСотрудникиФктВремяОРПДВ.Параметры.ФИОработникаФактВремяОРПДВ = Элемент.Сотрудник;
			 ОбластьСотрудникиФктВремяОРПДВ.Параметры.ДатаФактВремяОРПДВ         = Формат(Элемент.Дата,"ДФ=dd.MM.yyyy");
			 ОбластьСотрудникиФктВремяОРПДВ.Параметры.ЧасыФактВремяОРПДВ         = Элемент.Часы;
			 ТабДокумент.Вывести(ОбластьСотрудникиФктВремяОРПДВ);
		 КонецЦикла;
		 
	КонецЕсли;
	
	
	
	//Двойной размер оплаты только (все кроме овощеводов)	
	
	
	
	Если МассивФактДР.Количество() > 0 Тогда
		
		ОбластьФактВремяДР             = Макет.ПолучитьОбласть("ФактВремяДР");
		ТабДокумент.Вывести(ОбластьФактВремяДР);
		ОбластьСотрудникиФактВремяДР   = Макет.ПолучитьОбласть("СотрудникиФактВремяДР");
		
		Для Каждого Элемент Из МассивФактДР Цикл
			 ОбластьСотрудникиФактВремяДР.Параметры.ФИОработникаФактВремяДР = Элемент.Сотрудник;
			 ОбластьСотрудникиФактВремяДР.Параметры.ДатаФактВремяДР         = Формат(Элемент.Дата,"ДФ=dd.MM.yyyy");
			 ОбластьСотрудникиФактВремяДР.Параметры.ЧасыФактВремяДР         = Элемент.Часы;
			 ТабДокумент.Вывести(ОбластьСотрудникиФактВремяДР);
		 КонецЦикла;
	КонецЕсли;
	
	//ОбластьПодвал
	
	ОбластьПодвал.Параметры.Дата        = Формат(МассивОбъектов.Дата,"ДФ=MMM.yyyy");
	ОбластьПодвал.Параметры.ДолжностьГД = МассивОбъектов.ДолжностьРуководителя;
	ОбластьПодвал.Параметры.ГД          = МассивОбъектов.Руководитель.Инициалы + " " + МассивОбъектов.Руководитель.Фамилия;
	ТабДокумент.Вывести(ОбластьПодвал);
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	//ОбластьОзнакомления
	ОбластьОзнакомление.Параметры.ДатаОЗ = Формат(МассивОбъектов.Дата,"ДФ=dd.MM.yyyy");
	ОбластьОзнакомление.Параметры.НомерОЗ = МассивОбъектов.Номер;
	ТабДокумент.Вывести(ОбластьОзнакомление);
		
	ЗапросОЗ = Новый Запрос;
	ЗапросОЗ.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник КАК Сотрудник,
		|	КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность
		|ИЗ
		|	Документ.РаботаВВыходныеИПраздничныеДни.Сотрудники КАК РаботаВВыходныеИПраздничныеДниСотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних КАК КадроваяИсторияСотрудниковСрезПоследних
		|		ПО РаботаВВыходныеИПраздничныеДниСотрудники.Сотрудник.Ссылка = КадроваяИсторияСотрудниковСрезПоследних.Сотрудник
		|ГДЕ
		|	РаботаВВыходныеИПраздничныеДниСотрудники.Ссылка = &Ссылка";
	
	ЗапросОЗ.УстановитьПараметр("Ссылка",МассивОбъектов);
	РезультатЗапросаОЗ = ЗапросОЗ.Выполнить();
	
	ВыборкаДетальныеЗаписиОЗ = РезультатЗапросаОЗ.Выбрать();
	
	Пока ВыборкаДетальныеЗаписиОЗ.Следующий() Цикл
		 ОбластьСотрудникОЗ.Параметры.ДолжностьОЗ = ВыборкаДетальныеЗаписиОЗ.Должность;
		 ОбластьСотрудникОЗ.Параметры.ФИООЗ       = ВыборкаДетальныеЗаписиОЗ.Сотрудник;
		 ТабДокумент.Вывести(ОбластьСотрудникОЗ);
	КонецЦикла;
		
	ТабДокумент.АвтоМасштаб = Истина;
	Возврат ТабДокумент;
КонецФункции

Функция СформироватьПриказОПривлеченииКРаботеВВыходнойДен(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)Экспорт
	
	
	
КонецФункции

функция ПолучитьДолжностьОтветственного(ФизическоеЛицо)

	Запрос = Новый Запрос;
	Запрос.Текст =  
