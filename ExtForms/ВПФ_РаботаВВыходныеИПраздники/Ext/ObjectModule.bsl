		Для а = 1 по СтрДлина(Сотрудник.Инициалы) цикл
			Если Сред(Сотрудник.Инициалы, а, 1) <> " " Тогда
				инициалы = инициалы + Сред(Сотрудник.Инициалы, а, 1);
			КонецЕсли;
		КонецЦикла;
