	ОбластьПункт6.Параметры.МесяцПрописью = НРег(Формат(МассивОбъектов.ДатаНачалаСобытия, "ДФ=MMMM"));
	ОбластьПункт6.Параметры.Год = Формат(МассивОбъектов.ДатаНачалаСобытия, "ДФ=yyyy");
	
	НомерПункта = НомерПункта +1;
	ТабДокумент.Вывести(ОбластьПункт6);
	
	ОбластьПункт7.Параметры.НомерПункта = НомерПункта;

	ТабДокумент.Вывести(ОбластьПункт7);
	
